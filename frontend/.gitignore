# .gitignore

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
coverage/

# Debug
*.inspector
*.chrome

# Production
*.pid
*.seed
*.pid.lock

# Optional: exclude sensitive files
*.pem
*.key
*.cert

# Temporary files
tmp/
temp/
.cache/

# API keys
.env*
!.env.example